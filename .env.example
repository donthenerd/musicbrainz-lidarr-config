# MusicBrainz/Lidarr Stack Configuration
# Copy this file to .env and fill in your values

# Host Configuration
MUSICBRAINZ_HOST=drteeth
MUSICBRAINZ_IP=10.21.1.10
POSTGRES_HOST=10.21.1.9
NFS_HOST=10.21.1.9

# PostgreSQL Credentials
POSTGRES_USER=abc
POSTGRES_PASSWORD=changeme

# API Keys - obtain from respective services
# Spotify: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URL=https://musicbrainz.yourdomain.com

# Fanart.tv: https://fanart.tv/get-an-api-key/
FANART_KEY=

# Last.fm: https://www.last.fm/api/account/create
LASTFM_KEY=
LASTFM_SECRET=

# TheAudioDB: https://www.theaudiodb.com/api_guide.php
TADB_KEY=2

# MusicBrainz Replication Token
# Get from: https://metabrainz.org/supporters/account-type
METABRAINZ_TOKEN=

# Traefik Domain
TRAEFIK_DOMAIN=musicbrainz.yourdomain.com

# Memory Settings
POSTGRES_SHARED_BUFFERS=4GB
SOLR_HEAP=16g

# User/Group for Solr (match your NFS permissions)
SOLR_UID=8675309
SOLR_GID=8675309

# NFS Volume Paths
NFS_SOLRDATA_PATH=/mnt/eightsixes1/borrowed/sabnzbd/musicbrainz-solrdata
NFS_SOLRDUMP_PATH=/mnt/eightsixes1/borrowed/sabnzbd/musicbrainz-solr-backup
